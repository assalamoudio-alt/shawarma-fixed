# Copier vers .env sur le VPS OVH : cp .env.example .env
# Puis modifier toutes les valeurs CHANGE_ME

# Mot de passe PostgreSQL (fort, 20+ caractères)
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# Secret JWT pour les connexions utilisateurs
JWT_SECRET=CHANGE_ME_jwt_secret_long_random

# URL publique du site (avec https après configuration SSL)
FRONTEND_URL=https://votredomaine.com

# Domaine pour Nginx / Certbot (sans https://)
DOMAIN=votredomaine.com
